{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "payment.shahedulislamovi.com"
        }
      ],
      "destination": "/payment"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "payment.shahedulislamovi.com"
        }
      ],
      "destination": "/payment/$1"
    }
  ]
}
